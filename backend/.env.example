# Environment Mode (development | production | test)
NODE_ENV=development

# Server Port
PORT=4000

# PostgreSQL Connection URL
# Example for Docker Compose: postgresql://musab_user:musab_password@localhost:5432/musabkanat_db?schema=public
DATABASE_URL="postgresql://musab_user:musab_password@localhost:5432/musabkanat_db?schema=public"

# JWT Authentication Secret (Generate with: openssl rand -base64 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-me"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (Comma separated for multiple)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Initial Admin Credentials for Database Seed
ADMIN_NAME="Musab Admin"
ADMIN_EMAIL="admin@musabkanat.com"
ADMIN_PHONE="+905552194353"
ADMIN_PASSWORD="ChangeThisPassword123!"
